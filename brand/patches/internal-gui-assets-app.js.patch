+
+// Non-functional mentions of the code host are shown as a neutral phrase.
+// GitHub Copilot and GitHub Token keep their names: they are products, and
+// renaming them would say less than the truth. Text only; nothing is fetched.
+const CODE_HOST = document.documentElement.lang?.startsWith("zh") ? "代码托管" : "code host";
+const KEEPS_GITHUB = /Copilot|Token|token|令牌/;
+function softenCodeHost(root) {
+  if (!root) return;
+  const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+  for (let n = w.nextNode(); n; n = w.nextNode()) {
+    const s = n.nodeValue;
+    if (!s || !s.includes("GitHub") || KEEPS_GITHUB.test(s)) continue;
+    const p = n.parentElement;
+    if (!p || p.closest("input, textarea, select, script, style, [contenteditable='true']")) continue;
+    n.nodeValue = s.replace(/\bGitHub\b/g, CODE_HOST);
+  }
+}
+softenCodeHost(document.body);
+let softenTick = 0;
+new MutationObserver(() => {
+  if (softenTick) return;
+  softenTick = setTimeout(() => { softenTick = 0; softenCodeHost(document.body); }, 120);
+}).observe(document.body, { childList: true, subtree: true, characterData: true });
